<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Freight foreign regions and border anchors</title><style>__LEAFLET_CSS__</style><style>
*{box-sizing:border-box}body{margin:0;color:#1b3048;background:#f2f5f9;font:14px system-ui,sans-serif}header{background:#142c43;color:#fff;padding:20px 25px}h1{font-size:24px;margin:0 0 8px}header p{margin:0;color:#d6e1ed}.layout{display:grid;grid-template-columns:345px 1fr;height:78vh;min-height:650px}aside{padding:18px;overflow:auto;background:#fff}#map{height:100%;background:#e6ecf2}label{display:block;font-weight:650;font-size:12px;margin:14px 0 5px}select{width:100%;font:inherit;padding:8px;border:1px solid #becbd9;border-radius:5px}button,input[type=search]{font:inherit;padding:7px;border:1px solid #becbd9;border-radius:5px}button{background:#eef3f8;cursor:pointer;margin:4px 3px 4px 0}input[type=range]{width:100%}.muted{font-size:12px;color:#53667b;line-height:1.7}.notice{background:#fff2d7;padding:11px;border-left:3px solid #d2951c;margin:14px 0;line-height:1.6}#details{padding:13px 0;border-top:1px solid #dbe3ec;line-height:1.8;overflow-wrap:anywhere}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:18px 0}.card{padding:16px;background:#fff;border-radius:8px}.big{font-size:24px;font-weight:700;margin-top:6px}.bottom{padding:20px;max-width:1600px;margin:auto}.panel{padding:18px;background:white;border-radius:9px;margin:18px 0}h2{font-size:19px}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:9px;border-bottom:1px solid #e0e7ef;text-align:right}th:first-child,td:first-child{text-align:left}tbody tr{cursor:pointer}tbody tr:hover{background:#edf4fa}.key{display:inline-block;width:11px;height:11px;border-radius:50%;margin-right:5px}a{color:#1d65a0}.exports{display:flex;gap:16px;flex-wrap:wrap}pre{white-space:pre-wrap;overflow-wrap:anywhere}#tileStatus{color:#8c4e11}.traffic-stats{background:#fff;padding:14px 25px}.traffic-stats h2{margin:0 0 8px}.traffic-stats td{font-size:20px;font-weight:700}.traffic-stats td:first-child{font-size:14px}.traffic-stats p{margin:8px 0 0}@media(max-width:800px){.layout{grid-template-columns:1fr;height:auto}aside{max-height:480px}#map{height:65vh}.cards{grid-template-columns:1fr 1fr}.bottom{padding:12px}}
</style></head><body><header><h1 id="reportTitle">Freight · foreign regions and selected border anchors</h1><p id="reportSubtitle">NPVM and legacy GTE/GQGV · Source geography → actual generated foreign endpoint</p></header>

<section class="traffic-stats" aria-labelledby="trafficStatsTitle"><h2 id="trafficStatsTitle">Trips entering, leaving and transiting Switzerland</h2><div class="scroll"><table><thead><tr><th>Freight model</th><th>Entering Switzerland</th><th>Leaving Switzerland</th><th>Transiting Switzerland</th></tr></thead><tbody id="trafficStats"></tbody></table></div><p class="muted">Full sampled demand for both models, independent of map filters. Entering: abroad → domestic. Leaving: domestic → abroad. Transit: abroad → abroad, counted once per trip and excluded from the entering/leaving totals. Classification uses source OD zones; NPVM domestic geography also includes Liechtenstein/enclaves.</p></section>
<div class="layout"><aside>
<label for="model">Freight method</label><select id="model"><option value="both">Both methods</option><option value="NPVM">NPVM</option><option value="Legacy">Legacy GTE/GQGV</option></select>
<label for="direction">Trip direction</label><select id="direction"><option value="all">All foreign endpoints</option><option value="incoming">Incoming · abroad → domestic</option><option value="outgoing">Outgoing · domestic → abroad</option><option value="transit">Foreign → foreign · both endpoints</option></select>
<label for="regionSelect">Foreign source region</label><select id="regionSelect"><option value="">All regions</option></select>
<button id="clear">Clear selection</button><button id="swiss">Switzerland</button><button id="fitRegions">Fit visible regions</button><button id="fitAnchor">Zoom to selected anchor</button>
<label><input id="showRegions" type="checkbox" checked> Show original foreign regions</label>
<label><input id="showAnchors" type="checkbox" checked> Show selected border anchors</label>
<label><input id="showMappings" type="checkbox" checked> Source centroid → anchor, for selection</label>
<label><input id="showTrips" type="checkbox"> Show generated trip OD lines</label>
<label for="background">Map background</label><select id="background"><option value="swiss">Swisstopo national map</option><option value="global">NASA Blue Marble · global imagery</option><option value="none">No background</option></select>
<label for="opacity">Background opacity <span id="opacityValue">65%</span></label><input id="opacity" type="range" min="0" max="100" value="65">
<p id="modelLegend"></p>
<div id="details">Click a foreign region or border marker. Selecting a shared anchor highlights every contributing source region.</div>
<div class="notice"><strong>Selected anchors, not observed border passages.</strong> Points are taken from generated trip coordinates. Network-mode NPVM samples eligible directed crossing links using road hierarchy; geometric mode can place points away from roads. Dashed centroid-to-anchor links show the assignment rule; they are not trip routes.</div>
<p class="muted">Swisstopo covers Switzerland. Use the verified NASA background when viewing foreign regions beyond its coverage. Polygons, markers and tables stay available if tiles fail.</p><div id="tileStatus" class="muted" role="status"></div>
</aside><div id="map" aria-label="Foreign freight regions and border anchors"></div></div>
<div class="bottom"><div class="cards"><div class="card">Visible cross-border OD trips<div class="big" id="tripCount"></div></div><div class="card">Foreign endpoint occurrences<div class="big" id="eventCount"></div></div><div class="card">Foreign source regions<div class="big" id="regionCount"></div></div><div class="card">Distinct anchors within methods<div class="big" id="anchorCount"></div></div></div>
<p class="muted">Each incoming/outgoing OD contributes one foreign endpoint. Each foreign-to-foreign OD contributes two: entry and exit. These are sampled trip records, not counts of distinct trucks or observed border passages. Coordinates shared by several regions are merged into a single marker within each method.</p>
<section class="panel"><h2>Foreign regions and their selected anchors</h2><label for="search">Search region ID or name</label><input id="search" type="search" placeholder="e.g. FR or Genève"><p class="muted" id="regionTableSummary"></p><div class="scroll"><table><thead><tr><th>Method · foreign region</th><th>Incoming</th><th>Outgoing</th><th>Transit entry</th><th>Transit exit</th><th>Selected-direction endpoints</th><th>Anchors</th></tr></thead><tbody id="regionTable"></tbody></table></div></section>
<section class="panel"><h2>Selected border anchors</h2><p class="muted" id="anchorTableSummary"></p><div class="scroll"><table><thead><tr><th>Method · anchor</th><th>Latitude</th><th>Longitude</th><th>Selected-direction endpoints</th><th>Foreign regions</th><th>Distance to Swiss boundary (m)</th></tr></thead><tbody id="anchorTable"></tbody></table></div></section>
<section class="panel"><h2>Audit and downloads</h2><p class="muted" id="diagnostics"></p><div class="exports"><a href="region_anchor_counts.csv">Region → anchor counts</a><a href="region_counts.csv">Region totals</a><a href="anchor_counts.csv">Anchor coordinates and counts</a><a href="provenance.json">Source information</a></div><details><summary>Source assumptions and cache provenance</summary><pre id="provenance" class="muted"></pre></details></section>
</div><script>__LEAFLET_JS__</script><script>
'use strict';
const DATA=__DATA__;
const META=__META__;
const el=id=>document.getElementById(id),fmt=n=>Number(n).toLocaleString('en-GB',{maximumFractionDigits:3}),COLORS=META.colors||{NPVM:'#216db1',Legacy:'#c06436'};
if(META.title)el('reportTitle').textContent=META.title;if(META.subtitle)el('reportSubtitle').textContent=META.subtitle;
el('model').replaceChildren();for(const [value,label] of [['both','Both methods'],...Object.keys(DATA.models).map(m=>[m,m])]){const option=document.createElement('option');option.value=value;option.textContent=label;el('model').append(option);}el('model').value='both';
for(const model of Object.keys(DATA.models)){const key=document.createElement('span');key.className='key';key.style.background=COLORS[model];el('modelLegend').append(key,model+' ');}
const map=L.map('map',{preferCanvas:true}).setView([46.85,8.25],7);
const backgrounds={swiss:L.tileLayer('https://wmts.geo.admin.ch/1.0.0/ch.swisstopo.pixelkarte-farbe/default/current/3857/{z}/{x}/{y}.jpeg',{opacity:.65,maxZoom:19,maxNativeZoom:18,noWrap:true,attribution:'© <a href="https://www.swisstopo.admin.ch/">swisstopo</a>'}),global:L.tileLayer('https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/BlueMarble_ShadedRelief_Bathymetry/default/2004-01-01/GoogleMapsCompatible_Level8/{z}/{y}/{x}.jpeg',{opacity:.65,maxZoom:19,maxNativeZoom:8,noWrap:true,attribution:'Imagery: <a href="https://www.earthdata.nasa.gov/centers/gibs">NASA GIBS</a>'})};
backgrounds.swiss.addTo(map);for(const tile of Object.values(backgrounds))tile.on('tileerror',()=>{el('tileStatus').textContent='Some background tiles could not load. Regions, anchors, connection lines and tables remain usable.';});
L.control.scale({imperial:false}).addTo(map);L.geoJSON(DATA.border,{interactive:false,style:{color:'#172d43',weight:2,fill:false}}).addTo(map);
let selectedRegion='',selectedAnchor='',groups=L.layerGroup().addTo(map),regionLayers=new Map(),anchorLookup=new Map(),visibleRegions=[],visibleAnchors=[],visibleTrips=[];
const regionKey=(model,id)=>model+'|'+id;
const methods=()=>el('model').value==='both'?Object.keys(DATA.models):[el('model').value];
function roles(){return el('direction').value==='all'?['incoming','outgoing','transit_entry','transit_exit']:el('direction').value==='transit'?['transit_entry','transit_exit']:[el('direction').value];}
function count(row){return roles().reduce((sum,key)=>sum+(row[key]||0),0);}
function allocationAllowed(model,row){return !selectedRegion||selectedRegion===regionKey(model,row.region_id);}
function tip(lines){const d=document.createElement('div');for(const line of lines){const p=document.createElement('div');p.textContent=line;d.append(p);}return d;}
function selectRegion(model,id){selectedRegion=regionKey(model,id);selectedAnchor='';el('regionSelect').value=selectedRegion;update();}
function selectAnchor(id){selectedAnchor=id;selectedRegion='';el('regionSelect').value='';update();}
function setBackground(){for(const tile of Object.values(backgrounds))map.removeLayer(tile);const t=backgrounds[el('background').value];if(t)t.setOpacity(Number(el('opacity').value)/100).addTo(map);}
function regionProperties(model,id){return DATA.models[model].regions.features.find(f=>f.properties.id===id)?.properties;}
function rebuildOptions(){el('regionSelect').replaceChildren();const all=document.createElement('option');all.value='';all.textContent='All foreign regions';el('regionSelect').append(all);for(const model of methods()){for(const feature of DATA.models[model].regions.features.slice().sort((a,b)=>a.properties.id.localeCompare(b.properties.id))){const p=feature.properties;if(!count(p))continue;const option=document.createElement('option');option.value=regionKey(model,p.id);option.textContent=`${model} · ${p.id} · ${p.name} (${fmt(count(p))})`;el('regionSelect').append(option);}}el('regionSelect').value=selectedRegion;}
function update(){
 groups.clearLayers();regionLayers=new Map();anchorLookup=new Map();visibleRegions=[];visibleAnchors=[];visibleTrips=[];
 for(const model of methods()){
  const d=DATA.models[model],activeRegions=new Set();
  for(const anchor of d.anchors){anchorLookup.set(anchor.anchor_id,{model,...anchor});if(selectedAnchor&&selectedAnchor!==anchor.anchor_id)continue;const allocations=anchor.allocations.filter(a=>count(a)>0&&allocationAllowed(model,a));const n=allocations.reduce((s,a)=>s+count(a),0);if(!n)continue;visibleAnchors.push({model,...anchor,visibleCount:n,visibleAllocations:allocations});for(const a of allocations)activeRegions.add(a.region_id);}
  for(const feature of d.regions.features){const p=feature.properties;if(!activeRegions.has(p.id))continue;visibleRegions.push({model,...p});const chosen=selectedRegion===regionKey(model,p.id)||!!selectedAnchor;
   const layer=L.geoJSON(feature,{bubblingMouseEvents:false,pointToLayer:(f,ll)=>L.circle(ll,{radius:800}),style:{color:COLORS[model],weight:chosen?2.5:1,fillColor:COLORS[model],fillOpacity:chosen ? .24 : .055},onEachFeature(f,path){path.bindTooltip(()=>tip([model+' · '+p.id+' · '+p.name,fmt(count(p))+' foreign endpoint occurrences',p.source_geometry==='Point'?'Source point only; no published polygon':'Click to select this region']));path.on('click',()=>selectRegion(model,p.id));}});regionLayers.set(regionKey(model,p.id),layer);if(el('showRegions').checked)layer.addTo(groups);
  }
  for(const trip of d.trips){if(el('direction').value!=='all'&&trip.scope!==el('direction').value)continue;if(selectedRegion&&selectedRegion!==regionKey(model,trip.origin_zone)&&selectedRegion!==regionKey(model,trip.destination_zone))continue;if(selectedAnchor&&trip.origin_anchor!==selectedAnchor&&trip.destination_anchor!==selectedAnchor)continue;visibleTrips.push({model,...trip});if(el('showTrips').checked)L.polyline([trip.a,trip.b],{color:COLORS[model],weight:1,opacity:.2,interactive:false}).addTo(groups);}
 }
 for(const anchor of visibleAnchors){
  if(el('showMappings').checked&&(selectedRegion||selectedAnchor)){for(const a of anchor.visibleAllocations){const p=regionProperties(anchor.model,a.region_id);L.polyline([[p.centroid_lat,p.centroid_lon],[anchor.lat,anchor.lon]],{color:COLORS[anchor.model],dashArray:'6 5',weight:2,opacity:.85}).bindTooltip(tip([anchor.model+' · '+a.region_id+' → '+anchor.anchor_id,fmt(count(a))+' foreign endpoint occurrences','Centroid-to-anchor assignment, not a trip route'])).addTo(groups);L.circleMarker([p.centroid_lat,p.centroid_lon],{radius:4,color:COLORS[anchor.model],fillOpacity:1}).bindTooltip(tip(['Source centroid: '+a.region_id])).addTo(groups);}}
  if(el('showAnchors').checked)L.circleMarker([anchor.lat,anchor.lon],{radius:Math.min(15,4+Math.log2(1+anchor.visibleCount)),color:anchor.boundary_distance_m>1?'#be1622':COLORS[anchor.model],weight:selectedAnchor===anchor.anchor_id?4:2,fillColor:COLORS[anchor.model],fillOpacity:.75,bubblingMouseEvents:false}).bindTooltip(()=>tip([anchor.anchor_id,fmt(anchor.visibleCount)+' foreign endpoint occurrences',anchor.visibleAllocations.length+' contributing regions','Click to show all contributing source regions'])).on('click',()=>selectAnchor(anchor.anchor_id)).addTo(groups);
 }
 el('tripCount').textContent=fmt(visibleTrips.length);el('eventCount').textContent=fmt(visibleAnchors.reduce((s,a)=>s+a.visibleCount,0));el('regionCount').textContent=fmt(visibleRegions.length);el('anchorCount').textContent=fmt(visibleAnchors.length);
 el('details').replaceChildren();if(selectedRegion){const p=visibleRegions.find(p=>regionKey(p.model,p.id)===selectedRegion);if(p)el('details').append(tip([p.model+' · '+p.id+' · '+p.name,'Incoming '+fmt(p.incoming)+' · outgoing '+fmt(p.outgoing),'Foreign/foreign: entry '+fmt(p.transit_entry)+' · exit '+fmt(p.transit_exit),'Dashed lines connect the source centroid to the actual anchor(s).']));else el('details').textContent='This region has no endpoints in the selected direction.';}else if(selectedAnchor){const a=anchorLookup.get(selectedAnchor);if(a)el('details').append(tip([a.anchor_id,'Latitude '+a.lat.toFixed(6)+' · longitude '+a.lon.toFixed(6),'EPSG:2056 '+a.x.toFixed(3)+', '+a.y.toFixed(3),'Distance to Swiss boundary '+fmt(a.boundary_distance_m)+' m','Contributing regions are highlighted; zoom out or fit visible regions to inspect them.']));}else el('details').textContent='Click a foreign region or border marker. Selecting a shared anchor highlights every contributing source region.';
 tables();
}
function row(parent,values,action){const tr=document.createElement('tr');for(const value of values){const td=document.createElement('td');td.textContent=value;tr.append(td);}tr.onclick=action;parent.append(tr);}
function tables(){
 const search=el('search').value.trim().toLocaleLowerCase();const regions=visibleRegions.filter(r=>(r.model+' '+r.id+' '+r.name).toLocaleLowerCase().includes(search)).sort((a,b)=>count(b)-count(a)||a.id.localeCompare(b.id));el('regionTable').replaceChildren();for(const p of regions.slice(0,150)){const anchors=visibleAnchors.filter(a=>a.model===p.model&&a.visibleAllocations.some(r=>r.region_id===p.id));const n=anchors.reduce((s,a)=>s+a.visibleAllocations.filter(r=>r.region_id===p.id).reduce((s,r)=>s+count(r),0),0);row(el('regionTable'),[p.model+' · '+p.id+' · '+p.name,fmt(p.incoming),fmt(p.outgoing),fmt(p.transit_entry),fmt(p.transit_exit),fmt(n),fmt(anchors.length)],()=>selectRegion(p.model,p.id));}el('regionTableSummary').textContent=`Showing ${Math.min(150,regions.length)} of ${fmt(regions.length)} matching regions. The four directional columns are full region totals; selected-direction endpoints reflect current filters. Full aggregates are in CSV downloads.`;
 el('anchorTable').replaceChildren();const anchors=visibleAnchors.slice().sort((a,b)=>b.visibleCount-a.visibleCount);for(const a of anchors.slice(0,150))row(el('anchorTable'),[a.anchor_id,a.lat.toFixed(6),a.lon.toFixed(6),fmt(a.visibleCount),fmt(a.visibleAllocations.length),fmt(a.boundary_distance_m)],()=>{selectAnchor(a.anchor_id);map.setView([a.lat,a.lon],12);});el('anchorTableSummary').textContent=`Showing ${Math.min(150,anchors.length)} of ${fmt(anchors.length)} visible anchors. Click a row to zoom to its actual generated coordinate. Shared markers count all contributing source regions.`;
}
el('model').onchange=()=>{selectedRegion='';selectedAnchor='';rebuildOptions();update();};el('direction').onchange=()=>{rebuildOptions();update();};el('regionSelect').onchange=()=>{selectedRegion=el('regionSelect').value;selectedAnchor='';update();};el('clear').onclick=()=>{selectedRegion='';selectedAnchor='';el('regionSelect').value='';update();};
for(const id of ['showRegions','showAnchors','showMappings','showTrips'])el(id).onchange=update;
el('search').oninput=tables;el('background').onchange=setBackground;el('opacity').oninput=()=>{el('opacityValue').textContent=el('opacity').value+'%';for(const t of Object.values(backgrounds))t.setOpacity(Number(el('opacity').value)/100);};
el('swiss').onclick=()=>map.setView([46.85,8.25],7);el('fitRegions').onclick=()=>{const bounds=L.latLngBounds([]);for(const layer of regionLayers.values())bounds.extend(layer.getBounds());if(bounds.isValid())map.fitBounds(bounds,{padding:[25,25],maxZoom:10});};el('fitAnchor').onclick=()=>{const a=anchorLookup.get(selectedAnchor)||visibleAnchors[0];if(a)map.setView([a.lat,a.lon],12);};
for(const model of Object.keys(DATA.models)){const d=DATA.models[model].diagnostics;row(el('trafficStats'),[model,fmt(d.incoming_trips),fmt(d.outgoing_trips),fmt(d.transit_ods)]);}
el('diagnostics').textContent=Object.entries(DATA.models).map(([name,d])=>`${name}: ${fmt(d.diagnostics.incoming_trips)} incoming trips; ${fmt(d.diagnostics.outgoing_trips)} outgoing; ${fmt(d.diagnostics.transit_ods)} foreign-to-foreign ODs. Maximum anchor distance to Swiss boundary: ${fmt(d.diagnostics.max_boundary_distance_m)} m; ${fmt(d.diagnostics.anchors_over_1m_from_border)} anchors over 1 m away.`).join(' ');
el('provenance').textContent=JSON.stringify(META,null,2);rebuildOptions();update();
</script></body></html>
